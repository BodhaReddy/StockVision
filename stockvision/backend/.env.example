# StockVision Backend Environment Configuration
APP_NAME="StockVision API"
APP_VERSION="1.0.0"
DEBUG=True

# Supabase PostgreSQL + Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-api-settings

# Caching Configuration (in seconds)
CACHE_TTL_HISTORY_SECONDS=300
CACHE_TTL_SEARCH_SECONDS=3600
CACHE_MAXSIZE=128
